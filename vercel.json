{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": ".",
  "rewrites": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "abs.benblaine.org" }],
      "destination": "/abs/index.html"
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "abs.benblaine.org" }],
      "destination": "/abs/:path*"
    }
  ]
}
